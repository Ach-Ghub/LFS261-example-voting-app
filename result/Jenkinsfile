pipeline{
  agent any
  tools{
    nodejs 'NodeJS 26.10.0'
  }

  stages{
     stage("build"){
       when{
           changeset "**/result/**"
         }
         steps{
             echo 'Compiling result app'
             dir('result'){
               sh 'npm compile'
             }
         }
     }

     stage("test"){
       when{
         changeset "**/result/**"
         }
         steps{
              echo 'Running Unit Tests on result app'
              dir('result'){
                sh 'npm install'
                sh 'npm test'
              }
          }
     }
}
